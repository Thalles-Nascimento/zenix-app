<?xml version="1.0" encoding="UTF-8" ?>
<Configuration>
    <Properties>
        <Property name="LOG_PATH">logs</Property>
    </Properties>

    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout
                    disableAnsi="false"
                    pattern="%n%style{%d{yyyy-MM-dd HH:mm:ss.SSS}}{magenta dim} [%t] %highlight{%-5level} %style{%logger{36}}{cyan bold}: %msg%n%style{%ex{5}}{yellow}"
            />
        </Console>
        <RollingFile name="FileAppender"
                     fileName="${LOG_PATH}/zenixapp.log"
                     filePattern="${LOG_PATH}/zenixapp_%d{yyyy-MM-dd}-%i.log.gz">

            <PatternLayout
                    disableAnsi="false"
                    pattern="%style{%d{yyyy-MM-dd HH:mm:ss.SSS}}{magenta dim} Thread: [%t] Level: %highlight{%-5level}  %style{%logger{36}}{cyan bold}: %msg%n%style{%ex{5}}{yellow}"/>

            <Policies>
                <!-- Tamanho máximo dos arquivos de log - gatilho para rotatividade -->
                <SizeBasedTriggeringPolicy size="10MB" />
            </Policies>

            <!-- Quantidade máxima de arquivos na pasta de 'logs' -->
            <DefaultRolloverStrategy max="10">
                <Delete basePath="${LOG_PATH}" maxDepth="1">
                    <IfFileName glob="zenixapp_*.log.gz" />
                    <IfAccumulatedFileCount exceeds="10" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>


    </Appenders>

    <Loggers>
        <!-- CONFIGURAÇÕES PARA O PROFILE: DEV -->
        <SpringProfile name="dev">
            <Root level="WARN">
                <AppenderRef ref="ConsoleAppender" />
                <AppenderRef ref="FileAppender" />
            </Root>

            <Logger name="cloud.zenixapp.zenix" level="INFO" additivity="false">
                <AppenderRef ref="ConsoleAppender" />
                <AppenderRef ref="FileAppender" />
            </Logger>

            <Logger name="org.springframework.web" level="TRACE" additivity="false">
                <AppenderRef ref="ConsoleAppender" />
                <AppenderRef ref="FileAppender" />
            </Logger>
        </SpringProfile>

        <!-- CONFIGURAÇÕES PARA O PROFILE: PROD (Produção / Homologação) -->
        <SpringProfile name="prod">
            <Root level="WARN">
                <AppenderRef ref="FileAppender" />
            </Root>

            <Logger name="cloud.zenixapp.zenix" level="INFO" additivity="false">
                <AppenderRef ref="FileAppender" />
            </Logger>

            <Logger name="org.springframework.web" level="INFO" additivity="false">
                <RegexFilter regex=".*Writing\s*\[\[\]\].*" onMatch="DENY" onMismatch="NEUTRAL"/>
                <AppenderRef ref="FileAppender" />
            </Logger>
        </SpringProfile>
    </Loggers>

</Configuration>